<section class="section-block" id="trayectoria" data-reveal-section>
	<div class="section-header">
		<p class="section-kicker">BITÁCORA DE VUELO</p>
		<h2 class="section-heading">Experiencia profesional y formación académica</h2>
		<p class="section-subtitle">
			Evolución continua combinando experiencia real en entornos productivos, innovación en
			hackathones y formación universitaria en Ciencias de la Computación.
		</p>
	</div>

	<div class="trajectory-columns">
		<!-- Columna Izquierda: Únicamente Experiencia Profesional -->
		<div class="experience-column">
			<div class="sub-heading">
				<span class="sub-dot" aria-hidden="true"></span>
				<h3>Experiencia Profesional</h3>
			</div>

			<div class="timeline-list">
				{
					experiences.map((exp) => (
						<article class="timeline-card space-card" data-reveal-card>
							<div class="timeline-meta">
								<span class="period-pill">{exp.period}</span>
								<span class="location-label">{exp.location}</span>
							</div>

							<div class="timeline-header">
								<h4>{exp.role}</h4>
								<p class="company-name">{exp.company}</p>
							</div>

							<p class="timeline-summary">{exp.summary}</p>

							<ul class="timeline-bullets">
								{exp.bullets.map((item) => (
									<li>{item}</li>
								))}
							</ul>

							<div class="timeline-tags">
								{exp.tags.map((tag) => (
									<span>{tag}</span>
								))}
							</div>
						</article>
					))
				}
			</div>
		</div>

		<!-- Columna Derecha: Educación y Cursos / Certificaciones -->
		<div class="education-column">
			<div class="sub-heading">
				<span class="sub-dot sub-dot-cyan" aria-hidden="true"></span>
				<h3>Educación y Cursos</h3>
			</div>

			<div class="edu-stack">
				{
					educationList.map((edu) => (
						<article class="edu-card space-card" data-reveal-card>
							<div class="edu-top">
								<span class="edu-type">{edu.type}</span>
								<span class="edu-period">{edu.period}</span>
							</div>
							<div class="edu-title-row">
								<h4>{edu.title}</h4>
								<span class="edu-badge">{edu.institution}</span>
							</div>
							<p>{edu.detail}</p>
						</article>
					))
				}
			</div>

			<div class="cert-grid">
				{
					certifications.map((cert) => (
						<article class="cert-card space-card" data-reveal-card>
							<div class="cert-top">
								<span class="cert-kicker">{cert.badge}</span>
								<span class="cert-org">{cert.org}</span>
							</div>
							<h4>{cert.title}</h4>
							<p>{cert.description}</p>
						</article>
					))
				}
			</div>
		</div>
	</div>

	<!-- Sección Inferior Simétrica de Ancho Total: Hackathones e Innovación (Grid 2 Columnas) -->
	<div class="hackathons-showcase">
		<div class="hackathons-divider">
			<span class="divider-line divider-line-left" aria-hidden="true"></span>
			<div class="sub-heading hackathons-heading">
				<span class="sub-dot" aria-hidden="true"></span>
				<h3>Hackathones e Innovación</h3>
			</div>
			<span class="divider-line divider-line-right" aria-hidden="true"></span>
		</div>

		<div class="hackathons-grid">
			{
				hackathons.map((item) => (
					<article class="hackathon-card space-card" data-reveal-card>
						<!-- Columna Izquierda: Miniatura Compacta estilo LinkedIn (220x135) -->
						<div class="hackathon-media-box">
							{item.layout === 'split' ? (
								<div class="hackathon-split-grid">
									{item.images.map((img) => (
										<img
											src={img.src}
											alt={img.alt}
											loading="lazy"
											data-lightbox-src={img.src}
											data-lightbox-alt={img.alt}
										/>
									))}
								</div>
							) : (
								<div
									class="hackathon-single-wrap"
									data-lightbox-src={item.images[0].src}
									data-lightbox-alt={item.images[0].alt}
								>
									<img
										src={item.images[0].src}
										alt={item.images[0].alt}
										loading="lazy"
									/>
									<span class="linkedin-external-badge" aria-hidden="true">
										<svg viewBox="0 0 24 24">
											<path d="M14 4h6v6" />
											<path d="M10 14 20 4" />
											<path d="M20 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h5" />
										</svg>
									</span>
								</div>
							)}
						</div>

						<!-- Columna Derecha: Contenido y Etiquetas -->
						<div class="hackathon-content">
							<div class="timeline-meta">
								<span class="period-pill">{item.period}</span>
								<span class="location-label">{item.rightMeta}</span>
							</div>

							<div class="timeline-header">
								<h4>{item.title}</h4>
								<p class="company-name">{item.subtitle}</p>
							</div>

							<p class="timeline-summary">{item.description}</p>
							<p class="hackathon-impact">{item.impactAndTeam}</p>

							<div class="timeline-tags">
								{item.tags.map((tag) => (
									<span>{tag}</span>
								))}
							</div>
						</div>
					</article>
				))
			}
		</div>
	</div>

	<!-- Visor modal limpio al hacer clic en cualquier miniatura -->
	<dialog class="hackathon-lightbox" id="hackathon-lightbox" aria-label="Vista ampliada de imagen">
		<div class="lightbox-frame">
			<button
				type="button"
				class="lightbox-close"
				id="lightbox-close"
				aria-label="Cerrar vista ampliada"
			>
				✕
			</button>
			<img id="lightbox-img" src="" alt="" />
		</div>
	</dialog>
</section>

<script>
	const setupHackathonLightbox = () => {
		const dialog = document.getElementById('hackathon-lightbox') as HTMLDialogElement | null;
		const dialogImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
		const closeBtn = document.getElementById('lightbox-close');
		const triggers = document.querySelectorAll<HTMLElement>('[data-lightbox-src]');

		if (!dialog || !dialogImg || dialog.dataset.bound === 'true') return;
		dialog.dataset.bound = 'true';

		triggers.forEach((el) => {
			el.addEventListener('click', () => {
				const src = el.dataset.lightboxSrc ?? '';
				const alt = el.dataset.lightboxAlt ?? '';
				dialogImg.src = src;
				dialogImg.alt = alt;
				dialog.showModal();
			});
		});

		closeBtn?.addEventListener('click', () => dialog.close());
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
	};

	setupHackathonLightbox();
	document.addEventListener('astro:after-swap', setupHackathonLightbox);
</script>

