						class="hero-photo"
						src="/foto-eudy.png"
						alt="Eudy Yunior Lorenzo Ramirez — Desarrollador Full Stack"
						width="210"
						height="210"
						fetchpriority="high"
					/>
				</div>
				<div class="location-pill">
					<span class="status-pulse" aria-hidden="true"></span>
					<span>Santo Domingo Este, RD</span>
				</div>
			</div>
		</div>

		<!-- Identidad principal, rol, typewriter y cita de Interstellar -->
