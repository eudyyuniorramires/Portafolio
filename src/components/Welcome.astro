			</h1>

			<blockquote class="interstellar-quote">
				<p>
					“Newton's Third Law: The only way to move forward, is to leave something behind”
				</p>
				<footer>— Interstellar · Endurance Mission Log</footer>
			</blockquote>

			<div class="hero-cta-row">
				<a class="primary-cta" href="#proyectos">
					<span>Explorar Proyectos</span>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M5 12h14m-6-6 6 6-6 6"></path>
					</svg>
				</a>
				<a
					class="secondary-cta"
					href="/eudy-yunior-lorenzo-ramirez-cv.pdf"
					download="Eudy-Yunior-Lorenzo-Ramirez-CV.pdf"
				>
					<span>Descargar CV</span>
				</a>
			</div>
		</div>

		<!-- Consola de escaneo de candidato -->
		<aside class="terminal-card space-card" aria-label="Consola de perfil técnico">
			<div class="terminal-head">
				<div class="terminal-dots" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</div>
				<span class="terminal-title">ENDURANCE // TELEMETRY</span>
			</div>

			<pre class="terminal-body"><span class="cmd-prompt">$</span> <span class="cmd-exec">profile.scan --candidate "eudy-yunior"</span>
<span class="cmd-key">role:</span>     Desarrollador Full Stack
<span class="cmd-key">base:</span>     Santo Domingo Este, RD
<span class="cmd-key">backend:</span>  C#, .NET 8, ASP.NET Core, EF Core, JWT
<span class="cmd-key">frontend:</span> React, JS/TS, Tailwind, Bootstrap
<span class="cmd-key">data:</span>     SQL Server, SQL Azure, ETL / DW
<span class="cmd-key">status:</span>   <span class="cmd-ok">ONLINE · OPEN FOR OPPORTUNITIES</span></pre>
		</aside>
	</div>

	<!-- Franja translúcida con enlaces de perfil y contacto directo -->
	<div class="profile-links-strip" aria-label="Enlaces directos de perfil y contacto">
		{
			profileLinks.map((link) => (
				<a
					class="profile-link-chip space-card"
					href={link.href}
					target={link.external ? '_blank' : undefined}
					rel={link.external ? 'noopener noreferrer' : undefined}
				>
					<span class="chip-icon" aria-hidden="true">
						{link.icon === 'mail' && (
							<svg viewBox="0 0 24 24">
								<rect x="3" y="5" width="18" height="14" rx="2" />
								<path d="m3 7 9 6 9-6" />
							</svg>
						)}
						{link.icon === 'phone' && (
							<svg viewBox="0 0 24 24">
								<path d="M6.6 4h3.4l1.3 4.2-2.1 1.8a13.5 13.5 0 0 0 5.8 5.8l1.8-2.1L21 15v3.4a2 2 0 0 1-2.2 2A16.8 16.8 0 0 1 4.6 6.2 2 2 0 0 1 6.6 4Z" />
							</svg>
						)}
						{link.icon === 'linkedin' && (
							<svg viewBox="0 0 24 24">
								<rect x="3" y="3" width="18" height="18" rx="3" />
								<path d="M8 11v5M8 8v.01M12 16v-5c0-1.4 1-2.2 2.2-2.2S16.5 9.6 16.5 11v5" />
							</svg>
						)}
						{link.icon === 'github' && (
							<svg viewBox="0 0 24 24">
								<path d="M12 3a9 9 0 0 0-2.85 17.54c.45.08.62-.2.62-.44v-1.7c-2.5.54-3.03-1.08-3.03-1.08-.41-1.04-1-1.32-1-1.32-.82-.56.06-.55.06-.55.9.06 1.38.93 1.38.93.8 1.38 2.1.98 2.62.75.08-.58.31-.98.57-1.2-2-.23-4.1-1-4.1-4.43 0-.98.35-1.78.93-2.41-.1-.23-.4-1.15.09-2.4 0 0 .75-.24 2.47.92a8.56 8.56 0 0 1 4.5 0c1.72-1.16 2.47-.92 2.47-.92.49 1.25.19 2.17.09 2.4.58.63.93 1.43.93 2.41 0 3.44-2.1 4.2-4.11 4.42.32.28.61.83.61 1.67v2.47c0 .24.16.53.62.44A9 9 0 0 0 12 3Z" />
							</svg>
						)}
					</span>
					<div class="chip-meta">
						<span>{link.label}</span>
						<strong>{link.value}</strong>
					</div>
				</a>
			))
		}
	</div>
</section>

<script>
	const initHeroTypewriter = () => {
		const target = document.getElementById('hero-type-target');
		const container = document.querySelector('[data-typewriter]');
		if (!target || !container || container.getAttribute('data-typed') === 'true') return;
		container.setAttribute('data-typed', 'true');

		const fullText = container.getAttribute('data-typewriter') ?? '';
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		if (reducedMotion) {
			target.textContent = fullText;
			container.classList.add('typing-complete');
			return;
		}

		target.textContent = '';
		let index = 0;

		const typeNext = () => {
			target.textContent = fullText.slice(0, index);
			if (index < fullText.length) {
				index += 1;
				const currentChar = fullText[index - 1];
				const delay = currentChar === ' ' ? 18 : currentChar === ':' || currentChar === ',' ? 65 : 28;
				window.setTimeout(typeNext, delay);
			} else {
				container.classList.add('typing-complete');
			}
		};

		typeNext();
	};

	initHeroTypewriter();
	document.addEventListener('astro:after-swap', initHeroTypewriter);
</script>

<style>
	.hero-section {
		padding: 18px 0 56px;
		display: grid;
		gap: 28px;
	}

	.hero-top-grid {
		display: grid;
		grid-template-columns: 230px minmax(0, 1fr) minmax(300px, 360px);
		align-items: center;
		gap: 32px;
	}

	.hero-portrait-column {
		display: flex;
		justify-content: center;
	}

	.orbital-avatar {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 14px;
	}

	.orbit-ring {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
	}

	.orbit-ring-outer {
		width: 236px;
		height: 236px;
		top: 1px;
		border: 1px dashed rgba(251, 191, 36, 0.34);
		animation: slow-orbit 28s linear infinite;
	}

	.orbit-ring-inner {
		width: 218px;
		height: 218px;
		top: 10px;
		border: 1px solid rgba(255, 244, 214, 0.16);
		box-shadow:
			0 0 38px rgba(245, 158, 11, 0.2),
			inset 0 0 24px rgba(245, 158, 11, 0.14);
	}

	.photo-frame {
		position: relative;
		width: 204px;
		height: 204px;
		border-radius: 50%;
		overflow: hidden;
		border: 2px solid rgba(251, 191, 36, 0.55);
		background: radial-gradient(circle at 50% 35%, #1e293b, #090d16);
		box-shadow:
			0 22px 50px rgba(0, 0, 0, 0.72),
			0 0 32px rgba(245, 158, 11, 0.22);
	}

	.photo-frame::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		box-shadow: inset 0 0 28px rgba(5, 8, 18, 0.52);
		pointer-events: none;
	}

	.hero-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		filter: contrast(1.04) saturate(1.02);
	}

	.location-pill {
		margin-top: -14px;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 13px;
		border-radius: 999px;
		background: rgba(8, 12, 24, 0.9);
		border: 1px solid rgba(251, 191, 36, 0.34);
		backdrop-filter: blur(12px);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--text-primary);
		white-space: nowrap;
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.55);
	}

	.status-pulse {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--emerald-signal);
		box-shadow: 0 0 10px var(--emerald-signal);
	}

	.hero-copy {
		display: grid;
		gap: 14px;
	}

	.eyebrow-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
	}

	.eyebrow-badge {
		display: inline-flex;
		align-items: center;
		padding: 6px 12px;
		border-radius: 999px;
		background: rgba(245, 158, 11, 0.14);
		border: 1px solid rgba(251, 191, 36, 0.38);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		color: var(--amber-core);
	}

	.telemetry-tag {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		color: var(--text-muted);
	}

	.hero-role {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		font-size: 1rem;
		color: var(--text-secondary);
	}

	.hero-role strong {
		color: var(--text-primary);
		font-weight: 700;
	}

	.role-divider {
		color: var(--amber-gold);
	}

	.role-highlight {
		color: var(--amber-bright);
		font-weight: 600;
	}

	.hero-headline {
		font-size: clamp(1.85rem, 3.3vw, 2.75rem);
		line-height: 1.08;
		letter-spacing: -0.03em;
		min-height: 3.3em;
		text-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
	}

	.typing-caret {
		display: inline-block;
		width: 0.08em;
		height: 0.92em;
		margin-left: 0.1em;
		background: var(--amber-bright);
		vertical-align: -0.08em;
		animation: caret-blink 0.9s steps(1) infinite;
		box-shadow: 0 0 14px var(--amber-gold);
	}

	.interstellar-quote {
		margin: 4px 0 0;
		padding: 12px 16px;
		border-left: 2px solid var(--amber-bright);
		border-radius: 0 14px 14px 0;
		background: linear-gradient(90deg, rgba(245, 158, 11, 0.11), rgba(8, 11, 21, 0.42));
		backdrop-filter: blur(10px);
	}

	.interstellar-quote p {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 0.95rem;
		line-height: 1.45;
		color: var(--amber-core);
	}

	.interstellar-quote footer {
		margin-top: 5px;
		font-family: var(--font-mono);
		font-size: 0.67rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.hero-cta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
		margin-top: 4px;
	}

	.primary-cta,
	.secondary-cta {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		padding: 11px 20px;
		border-radius: 999px;
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			transform 200ms ease,
			box-shadow 200ms ease,
			border-color 200ms ease,
			background 200ms ease;
	}

	.primary-cta {
		background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
		color: #090b10;
		border: 1px solid rgba(255, 244, 214, 0.5);
		box-shadow: 0 12px 28px rgba(245, 158, 11, 0.3);
	}

	.primary-cta svg {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.primary-cta:hover {
		transform: translateY(-2px);
		box-shadow: 0 16px 34px rgba(245, 158, 11, 0.45);
	}

	.secondary-cta {
		background: rgba(10, 14, 26, 0.72);
		color: var(--text-primary);
		border: 1px solid var(--border-subtle);
		backdrop-filter: blur(14px);
	}

	.secondary-cta:hover {
		transform: translateY(-2px);
		border-color: var(--border-glow);
		color: var(--amber-core);
	}

	/* Consola Terminal */
	.terminal-card {
		padding: 18px;
		background: rgba(7, 10, 19, 0.8);
	}

	.terminal-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 12px;
		margin-bottom: 12px;
		border-bottom: 1px solid rgba(255, 226, 179, 0.1);
	}

	.terminal-dots {
		display: flex;
		gap: 6px;
	}

	.terminal-dots span {
		width: 9px;
		height: 9px;
		border-radius: 50%;
	}

	.terminal-dots span:nth-child(1) {
		background: #fb7185;
	}
	.terminal-dots span:nth-child(2) {
		background: #fbbf24;
	}
	.terminal-dots span:nth-child(3) {
		background: #34d399;
	}

	.terminal-title {
		font-family: var(--font-mono);
		font-size: 0.64rem;
		letter-spacing: 0.16em;
		color: var(--text-muted);
	}

	.terminal-body {
		margin: 0;
		white-space: pre-wrap;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		line-height: 1.72;
		color: var(--text-secondary);
	}

	.cmd-prompt {
		color: var(--amber-bright);
		font-weight: 700;
	}

	.cmd-exec {
		color: var(--amber-core);
		font-weight: 600;
	}

	.cmd-key {
		color: var(--cyan-telemetry);
	}

	.cmd-ok {
		color: var(--emerald-signal);
		font-weight: 600;
	}

	/* Franja de enlaces del perfil */
	.profile-links-strip {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 14px;
	}

	.profile-link-chip {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 14px 16px;
		border-radius: 18px;
		text-decoration: none;
		min-width: 0;
	}

	.chip-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border-radius: 11px;
		background: var(--amber-soft);
		border: 1px solid rgba(251, 191, 36, 0.25);
		color: var(--amber-bright);
		flex-shrink: 0;
		transition: transform 220ms ease;
	}

	.chip-icon svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.profile-link-chip:hover .chip-icon {
		transform: scale(1.08);
	}

	.chip-meta {
		display: grid;
		gap: 2px;
		min-width: 0;
	}

	.chip-meta span {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.chip-meta strong {
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--text-primary);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	@keyframes slow-orbit {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	@keyframes caret-blink {
		0%,
		49% {
			opacity: 1;
		}
		50%,
		100% {
			opacity: 0;
		}
	}

	@media (max-width: 1120px) {
		.hero-top-grid {
			grid-template-columns: 1fr;
			justify-items: start;
		}

		.hero-portrait-column {
			justify-content: flex-start;
		}

		.terminal-card {
			width: 100%;
			max-width: 540px;
		}

		.profile-links-strip {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.hero-portrait-column {
			width: 100%;
			justify-content: center;
		}

		.hero-headline {
			min-height: 0;
		}

		.profile-links-strip {
			grid-template-columns: 1fr;
		}
	}
</style>
