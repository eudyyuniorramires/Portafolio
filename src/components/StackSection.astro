---
const stackCategories = [
	{
		code: 'SYS // 01',
		title: 'Backend',
		subtitle: 'Lógica de negocio, servicios seguros, ORM y arquitecturas escalables.',
		accent: '#f59e0b',
		icon: 'server',
		skills: [
			'C#',
			'.NET',
			'ASP.NET Core',
			'Razor Pages',
			'EF Core',
			'API REST',
			'JWT',
			'Python'
		]
	},
	{
		code: 'SYS // 02',
		title: 'Frontend',
		subtitle: 'Interfaces reactivas, responsivas y orientadas a experiencia de usuario.',
		accent: '#38bdf8',
		icon: 'layers',
		skills: [
			'React',
			'JS',
			'TS básico',
			'HTML5',
			'CSS3',
			'Tailwind',
			'Bootstrap'
		]
	},
	{
		code: 'SYS // 03',
		title: 'Datos / DevOps',
		subtitle: 'Persistencia relacional en la nube, modelado dimensional y control de versiones.',
		accent: '#34d399',
		icon: 'database',
		skills: [
			'SQL Server',
			'SQL Azure',
			'Git',
			'GitHub'
		]
	}
];

const marqueeItems = [
	'C#',
	'.NET 8',
	'ASP.NET Core',
	'React',
	'Entity Framework Core',
	'SQL Server',
	'SQL Azure',
	'JWT Auth',
	'API REST',
	'Python',
	'JavaScript',
	'TypeScript',
	'Tailwind CSS',
	'Bootstrap',
	'Git & GitHub'
];

const tickerTrack = [...marqueeItems, ...marqueeItems];
---

<section class="section-block" id="stack" data-reveal-section>
	<div class="section-header">
		<p class="section-kicker">INGENIERÍA & CAPACIDADES</p>
		<h2 class="section-heading">Stack técnico con mentalidad Full Stack</h2>
		<p class="section-subtitle">
			Tecnologías articuladas para construir sistemas de extremo a extremo: desde bases de datos
			relacionales y APIs seguras en .NET hasta interfaces dinámicas en React.
		</p>
	</div>

	<div class="stack-grid">
		{
			stackCategories.map((category) => (
				<article
					class="stack-card space-card"
					style={`--domain-accent: ${category.accent};`}
					data-reveal-card
				>
					<div class="stack-card-top">
						<div class="domain-icon" aria-hidden="true">
							{category.icon === 'server' && (
								<svg viewBox="0 0 24 24">
									<rect x="3" y="4" width="18" height="6" rx="2" />
									<rect x="3" y="14" width="18" height="6" rx="2" />
									<path d="M7 7h.01M7 17h.01M11 7h6M11 17h6" />
								</svg>
							)}
							{category.icon === 'layers' && (
								<svg viewBox="0 0 24 24">
									<path d="m12 3 9 4.5-9 4.5-9-4.5L12 3Z" />
									<path d="m3 12 9 4.5 9-4.5" />
									<path d="m3 16.5 9 4.5 9-4.5" />
								</svg>
							)}
							{category.icon === 'database' && (
								<svg viewBox="0 0 24 24">
									<ellipse cx="12" cy="6" rx="7.5" ry="3" />
									<path d="M4.5 6v6c0 1.66 3.36 3 7.5 3s7.5-1.34 7.5-3V6" />
									<path d="M4.5 12v6c0 1.66 3.36 3 7.5 3s7.5-1.34 7.5-3v-6" />
								</svg>
							)}
						</div>
						<span class="domain-code">{category.code}</span>
					</div>

					<div class="stack-card-copy">
						<h3>{category.title}</h3>
						<p>{category.subtitle}</p>
					</div>

					<ul class="skill-tags" aria-label={`Tecnologías de ${category.title}`}>
						{category.skills.map((skill) => (
							<li class="skill-pill">
								<span class="pill-dot" aria-hidden="true" />
								<span>{skill}</span>
							</li>
						))}
					</ul>
				</article>
			))
		}
	</div>

	<div class="orbital-ticker space-card" aria-label="Cinta continua de tecnologías">
		<div class="ticker-track">
			{
				tickerTrack.map((tech) => (
					<span class="ticker-item">
						<span class="ticker-star" aria-hidden="true">✦</span>
						{tech}
					</span>
				))
			}
		</div>
	</div>
</section>

<style>
	.section-block {
		padding: 46px 0;
	}

	.section-header {
		margin-bottom: 28px;
	}

	.stack-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}

	.stack-card {
		padding: 26px;
		display: flex;
		flex-direction: column;
		gap: 20px;
		overflow: hidden;
	}

	.stack-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 24px;
		right: 24px;
		height: 2px;
		background: linear-gradient(90deg, transparent, var(--domain-accent), transparent);
		opacity: 0.7;
	}

	.stack-card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.domain-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 46px;
		height: 46px;
		border-radius: 14px;
		background: color-mix(in srgb, var(--domain-accent) 15%, transparent);
		border: 1px solid color-mix(in srgb, var(--domain-accent) 38%, transparent);
		color: var(--domain-accent);
	}

	.domain-icon svg {
		width: 22px;
		height: 22px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.domain-code {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		color: var(--text-muted);
		padding: 5px 10px;
		border-radius: 999px;
		border: 1px solid rgba(148, 163, 184, 0.18);
		background: rgba(15, 23, 42, 0.45);
	}

	.stack-card-copy h3 {
		font-size: 1.38rem;
		margin-bottom: 6px;
	}

	.stack-card-copy p {
		font-size: 0.9rem;
		line-height: 1.58;
		color: var(--text-secondary);
	}

	.skill-tags {
		list-style: none;
		padding: 0;
		margin: auto 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 9px;
	}

	.skill-pill {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 7px 12px;
		border-radius: 999px;
		background: rgba(15, 23, 42, 0.68);
		border: 1px solid rgba(255, 244, 214, 0.12);
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--text-primary);
		transition:
			border-color 180ms ease,
			transform 180ms ease,
			background-color 180ms ease;
	}

	.skill-pill:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--domain-accent) 60%, transparent);
		background: color-mix(in srgb, var(--domain-accent) 14%, rgba(15, 23, 42, 0.85));
	}

	.pill-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--domain-accent);
		box-shadow: 0 0 8px var(--domain-accent);
	}

	/* Cinta orbital inferior */
	.orbital-ticker {
		margin-top: 20px;
		overflow: hidden;
		border-radius: 999px;
		padding: 13px 0;
		background: rgba(7, 10, 19, 0.72);
	}

	.orbital-ticker:hover {
		transform: none;
	}

	.ticker-track {
		display: flex;
		width: max-content;
		gap: 28px;
		animation: orbital-scroll 30s linear infinite;
	}

	.orbital-ticker:hover .ticker-track {
		animation-play-state: paused;
	}

	.ticker-item {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		color: var(--text-secondary);
		white-space: nowrap;
	}

	.ticker-star {
		color: var(--amber-bright);
		font-size: 0.72rem;
	}

	@keyframes orbital-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (max-width: 1024px) {
		.stack-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
