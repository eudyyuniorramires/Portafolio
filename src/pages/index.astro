---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Welcome from '../components/Welcome.astro';
import StackSection from '../components/StackSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import TrajectorySection from '../components/TrajectorySection.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout
	title="Eudy Yunior Lorenzo Ramirez | Desarrollador Full Stack"
	description="Portafolio interactivo 3D inspirado en Interstellar de Eudy Yunior Lorenzo Ramirez, Desarrollador Full Stack en Santo Domingo Este (.NET, C#, React, SQL Server, Python)."
>
	<div class="portfolio-shell">
		<Navbar />

		<main class="portfolio-main">
			<Welcome />
			<StackSection />
			<ProjectsSection />
			<TrajectorySection />
			<ContactSection />
		</main>
	</div>
</Layout>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const initScrollReveals = () => {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		const sections = gsap.utils.toArray<HTMLElement>('[data-reveal-section]');
		sections.forEach((section, index) => {
			if (index === 0) {
				gsap.from(section, {
					opacity: 0,
					y: 18,
					duration: 0.85,
					ease: 'power3.out',
					clearProps: 'opacity,transform'
				});
				return;
			}

			const header = section.querySelector('.section-header, .section-header-row, .contact-copy');
			if (header) {
				gsap.from(header, {
					opacity: 0,
					y: 24,
					duration: 0.75,
					ease: 'power3.out',
					clearProps: 'opacity,transform',
					scrollTrigger: {
						trigger: section,
						start: 'top 84%',
						once: true
					}
				});
			}

			const cards = section.querySelectorAll('[data-reveal-card]');
			if (cards.length > 0) {
				gsap.from(cards, {
					opacity: 0,
					y: 28,
					duration: 0.72,
					stagger: 0.1,
					ease: 'power3.out',
					clearProps: 'opacity,transform',
					scrollTrigger: {
						trigger: section,
						start: 'top 80%',
						once: true
					}
				});
			}
		});
	};

	initScrollReveals();
	document.addEventListener('astro:after-swap', initScrollReveals);
</script>

<style>
	.portfolio-shell {
		position: relative;
		z-index: 1;
		padding: 20px 24px 0;
	}

	.portfolio-main {
		max-width: 1200px;
		margin: 0 auto;
	}

	@media (max-width: 640px) {
		.portfolio-shell {
			padding: 12px 16px 0;
		}
	}
</style>
